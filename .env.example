# Plantilla de configuración de NOVA AI.
#
# 1. Copia este archivo como `.env` (el `.env` nunca se sube a GitHub).
# 2. Completa los valores.
# 3. Ejecuta: flutter run --dart-define-from-file=.env
#
# IMPORTANTE: todo lo que se compila dentro de la app puede extraerse del APK,
# aunque no esté en GitHub. No pongas aquí claves privadas de servicios de pago
# (OpenAI, Anthropic, Google Places...). Esas claves deben vivir en un servidor,
# por ejemplo en Cloud Functions de Firebase.

# Entorno de ejecución: dev | qa | prod
NOVA_ENV=dev

# Modelo de Gemini usado a través de Firebase AI Logic
NOVA_GEMINI_MODEL=gemini-3.1-flash-lite

# App Check en modo depuración (web local, emuladores y teléfonos de prueba).
# Cada dispositivo genera un token que se registra en la consola de Firebase.
NOVA_APP_CHECK_DEBUG=true

# Clave de sitio de reCAPTCHA Enterprise para App Check en web (producción).
# Es pública por diseño; se deja vacía en desarrollo.
NOVA_RECAPTCHA_SITE_KEY=
