# Plantilla de configuración de NOVA AI.
#
# 1. Copia este archivo como `.env` (el `.env` nunca se sube a GitHub).
# 2. Completa los valores.
# 3. Ejecuta: flutter run --dart-define-from-file=.env
#
# IMPORTANTE: todo lo que se compila dentro de la app puede extraerse del APK,
# aunque no esté en GitHub. No pongas aquí claves privadas de servicios de pago
# (OpenAI, Anthropic, Google Places...). Esas claves deben vivir en un servidor,
# por ejemplo en Cloud Functions de Firebase.

# Entorno de ejecución: dev | qa | prod
NOVA_ENV=dev

# Modelo de Gemini usado a través de Firebase AI Logic
NOVA_GEMINI_MODEL=gemini-3.1-flash-lite

# App Check en modo depuración (web local, emuladores y teléfonos de prueba).
# Cada dispositivo genera un token que se registra en la consola de Firebase.
NOVA_APP_CHECK_DEBUG=true

# Clave de sitio de reCAPTCHA Enterprise para App Check en web (producción).
# Es pública por diseño; se deja vacía en desarrollo.
NOVA_RECAPTCHA_SITE_KEY=

# --- Servicios externos (no son secretos) ---------------------------------
# Enlaces que la app usa. Van aquí para poder cambiarlos sin tocar el código;
# si se omiten, la app usa estos mismos valores por defecto.

# Servidores de Overpass (lugares de OpenStreetMap), separados por comas y en
# orden de preferencia.
NOVA_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter

# Mapas base. Los servidores públicos de OpenStreetMap sirven para pruebas;
# para publicar la app usa un proveedor con su propia URL.
NOVA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Ruta en Google Maps para "Cómo llegar"; la app añade el destino.
NOVA_DIRECTIONS_URL=https://www.google.com/maps/dir/

# Página del proyecto: contacto que piden OpenStreetMap y Overpass.
NOVA_PROJECT_URL=https://github.com/VMichael1999/flutter-ios-demo
